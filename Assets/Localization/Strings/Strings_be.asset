  m_TableData:
  - m_Id: 433052442624
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u0446\u0456\u0446\u0435 A/D
      \u0434\u043B\u044F \u0442\u0430\u0433\u043E, \u043A\u0430\u0431 \u0440\u0443\u0445\u0430\u0446\u0446\u0430,
      \u0456 \u041F\u0440\u0430\u0431\u0435\u043B \u0434\u043B\u044F \u0442\u0430\u0433\u043E,
      \u043A\u0430\u0431 \u043F\u0430\u0434\u0441\u043A\u043E\u0447\u044B\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1180028624896
    m_Localized: "\u041F\u0430\u0432\u044F\u043B\u0456\u0447\u0446\u0435 \u0441\u0442\u0440\u044D\u0441
      \u0434\u043B\u044F \u0442\u0430\u0433\u043E, \u043A\u0430\u0431 \u0437\u0434\u0430\u0431\u044B\u0446\u044C
      \u043A\u0430\u043C\u0435\u043D\u044C (\u043A\u0430\u043B\u0456 \u0451\u043D
      \u044F\u0448\u0447\u044D \u0442\u0443\u0442)"
    m_Metadata:
      m_Items: []
  - m_Id: 1274052337664
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 E,
      \u043A\u0430\u0431 \u0432\u044B\u043B\u0435\u043A\u0430\u0432\u0430\u0446\u0446\u0430
      \u0456 \u043F\u0430\u0431\u0430\u0447\u044B\u0446\u044C, \u044F\u043A \u0437\u044C\u043C\u044F\u043D\u044F\u0435\u0446\u0446\u0430
      \u0441\u044C\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1421549232128
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 E,
      \u043A\u0430\u0431 \u0443\u0437\u0430\u0435\u043C\u0430\u0434\u0437\u0435\u0439\u043D\u0456\u0447\u0430\u0446\u044C
      \u0437 \u043F\u0440\u0430\u0434\u043C\u0435\u0442\u0430\u043C\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 1517317775360
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 \u041F\u0440\u0430\u0431\u0435\u043B,
      \u043A\u0430\u0431 \u043F\u0430\u0434\u0441\u043A\u043E\u0447\u044B\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1674394460160
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 \u041F\u0440\u0430\u0431\u0435\u043B
      \u0434\u0432\u043E\u0439\u0447\u044B \u0434\u043B\u044F \u0434\u0432\u0430\u0439\u043D\u043E\u0433\u0430
      \u043F\u0430\u0434\u0441\u043A\u043E\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1818674323456
    m_Localized: "\u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 W/S,
      \u043A\u0430\u0431 \u043F\u0430\u0433\u043B\u044F\u0434\u0437\u0435\u0446\u044C
      \u0443\u0432\u0435\u0440\u0445 \u0430\u043B\u044C\u0431\u043E \u045E\u043D\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1911854981120
    m_Localized: "\u0422\u0430\u043C \u0448\u0442\u043E\u0441\u044C\u0446\u0456 \u0451\u0441\u044C\u0446\u044C\u2026
      \u041D\u0430\u0446\u0456\u0441\u044C\u043D\u0456\u0446\u0435 F, \u043A\u0430\u0431
      \u043D\u0430\u043F\u0430\u0441\u044C\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2006088409088
    m_Localized: "\u0411\u044B\u0432\u0430\u0435 \u0442\u0430\u043A, \u0448\u0442\u043E
