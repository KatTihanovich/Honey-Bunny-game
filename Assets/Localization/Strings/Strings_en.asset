  m_TableData:
  - m_Id: 433052442624
    m_Localized: Press A/D to move and press Space to jump
    m_Metadata:
      m_Items: []
  - m_Id: 1180028624896
    m_Localized: Increase your stress to get the rock if it is still here
    m_Metadata:
      m_Items: []
  - m_Id: 1274052337664
    m_Localized: Press E to heal and see how the world can change
    m_Metadata:
      m_Items: []
  - m_Id: 1421549232128
    m_Localized: Press E to interact with objects
    m_Metadata:
      m_Items: []
  - m_Id: 1517317775360
    m_Localized: Press Space to jump
    m_Metadata:
      m_Items: []
  - m_Id: 1674394460160
    m_Localized: Press Space twice for double jump
    m_Metadata:
      m_Items: []
  - m_Id: 1818674323456
    m_Localized: Press W/S to look up and down
    m_Metadata:
      m_Items: []
  - m_Id: 1911854981120
    m_Localized: There is something down there, press F to attack
    m_Metadata:
      m_Items: []
  - m_Id: 2006088409088
    m_Localized: Sometimes you need to look into the darkness
    m_Metadata:
      m_Items: []
  - m_Id: 2183503273984
    m_Localized: Press Q to use ultimate and you can recharge it after killing two
      enemies
    m_Metadata:
      m_Items: []
